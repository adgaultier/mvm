# mvm integration suite — run against real microVMs.
#
# One recipe per section; each runs a plain bash script (sections/exec.sh, ...)
# inside a bash block that boots a fresh daemon via the `_serve` dependency
# (utils.just) and tears it down via `trap cleanup EXIT` — so a failing section
# still cleans up. Every section is self-contained.
#
#   just              # list sections (default recipe -> @just --list)
#   just exec         # run one section (boots a fresh daemon, cleans up after)
#   just all          # run every section (each self-contained)

import 'utils.just'

set positional-arguments

# Default: running `just` shows the available recipes, which are the sections.
_default:
    @just --list

# Run every section against ONE shared daemon: `_serve` boots it once, the
# loop sources each section script in this shell, and `trap cleanup EXIT`
# tears it down at the end. Individual section recipes below boot their own
# run all test suite
all: _serve
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{LIB}}"
    trap cleanup EXIT
    rc=0
    for sh in {{justfile_directory()}}/sections/*.sh; do
        echo ""
        if ! source "$sh"; then
            echo "❌ section $(basename "$sh" .sh) failed"
            rc=1
        fi
    done
    [ "$rc" -eq 0 ]

# --- sections (each boots the daemon via `_serve`, tears it down after) ------


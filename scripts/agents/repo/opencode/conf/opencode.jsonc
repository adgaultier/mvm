{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "model":"opencode/mimo-v2.5-free",
  "mcp": {
    "mvm-agent": {
      "type": "local",
      "command": ["uvx", "mvm-agent-mcp"],
      "enabled": true,
      "environment": {
        "NOTIFICATION_CMD": "SID=$(curl -s localhost:4096/session | jq -r 'sort_by(.time.updated) | reverse | map(select(.parentID == null)) | .[0].id'); curl -sS -X POST \"localhost:4096/session/$SID/prompt_async\" -H 'Content-Type: application/json' -d \"$(jq -n --arg text '<MSG>' '{parts:[{type:\"text\",text:$text}]}')\"",
        "MVM_GUEST_TOKEN": "{env:MVM_GUEST_TOKEN}"
      }
    }
  }
}
